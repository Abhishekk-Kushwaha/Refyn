# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# API Configuration
VITE_API_URL=http://localhost:3000

# AI solution explainer — URL of the ai-explain Edge Function.
# Leave blank to keep the "Explain with AI" button in its coming-soon state.
VITE_AI_EXPLAIN_URL=https://<project-ref>.supabase.co/functions/v1/ai-explain

# NOTE: AI API keys are deliberately NOT here. Every VITE_ variable is
# compiled into the browser bundle and is publicly readable. Keys are stored
# as Supabase secrets instead.
#
# The ai-explain function uses OpenRouter for multi-provider failover. When
# one AI provider hits quota, it automatically tries another. User never
# sees an error.
#
# Setup:
#   npx supabase secrets set OPENROUTER_API_KEY=your_key
#
# Get a free key at https://openrouter.ai — sign up, go to Keys, create one.
# See SETUP_OPENROUTER_AI.md for full details and troubleshooting.
