# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# API Configuration
VITE_API_URL=http://localhost:3000

# AI solution explainer — URL of the ai-explain Edge Function.
# Leave blank to keep the "Explain with AI" button in its coming-soon state.
VITE_AI_EXPLAIN_URL=https://<project-ref>.supabase.co/functions/v1/ai-explain

# NOTE: Gemini API keys are deliberately NOT here. Every VITE_ variable is
# compiled into the browser bundle and is publicly readable. Keys are stored
# as Supabase secrets instead. The function supports multiple keys (free tier
# quota multiplication).
#
# Setup (choose one):
#
# Single key (legacy):
#   npx supabase secrets set GEMINI_API_KEY=your_key
#
# Multiple keys (comma-separated):
#   npx supabase secrets set GEMINI_API_KEYS=key1,key2,key3
#
# Multiple keys (numbered):
#   npx supabase secrets set GEMINI_API_KEY_1=key1 GEMINI_API_KEY_2=key2 ...
