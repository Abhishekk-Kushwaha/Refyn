# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# API Configuration
VITE_API_URL=http://localhost:3000

# AI solution explainer — URL of the ai-explain Edge Function.
# Leave blank to keep the "Explain with AI" button in its coming-soon state.
VITE_AI_EXPLAIN_URL=https://<project-ref>.supabase.co/functions/v1/ai-explain

# NOTE: the Gemini API key is deliberately NOT here. Every VITE_ variable is
# compiled into the browser bundle and is publicly readable. The key is stored
# as a Supabase secret instead:
#   npx supabase secrets set GEMINI_API_KEY=your_key
